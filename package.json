{
  "name": "dsh-sidebar-timer",
  "version": "1.2.0",
  "type": "module",
  "description": "Usage timer chip at the DSH sidebar foot (sidebar.footer.action slot).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dok2014/dsh-sidebar-timer.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "timer",
    "sidebar"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/en.json", "locale/zh.json", "icon.svg"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-sidebar"]
    }
  }
}
